<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>SLO Studio Report</title>
  <style>
    body { font-family: Inter, system-ui, sans-serif; background:#f5f7fb; color:#172033; padding:32px; }
    .page { max-width:1180px; margin:0 auto; }
    .hero { background:linear-gradient(135deg,#0f172a,#065f46); color:white; padding:30px; border-radius:20px; margin-bottom:20px; }
    .hero h1 { margin:0 0 8px; font-size:30px; }
    .hero p { margin:0; opacity:.88; line-height:1.6; max-width:940px; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:18px; }
    .card { background:white; border:1px solid #e5e7eb; border-radius:14px; padding:18px; margin-bottom:16px; box-shadow:0 8px 22px rgba(15,23,42,.06); }
    .kpi { text-align:center; }
    .kpi strong { display:block; font-size:28px; color:#059669; }
    .kpi span { color:#64748b; font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.06em; }
    h2 { margin:0 0 12px; font-size:19px; }
    h3 { margin:0 0 8px; font-size:15px; }
    table { width:100%; border-collapse:collapse; font-size:13px; }
    th,td { padding:10px; border-bottom:1px solid #e5e7eb; text-align:left; vertical-align:top; }
    th { color:#64748b; text-transform:uppercase; font-size:11px; letter-spacing:.06em; }
    .summary-box { background:#ecfdf5; border:1px solid #bbf7d0; border-radius:14px; padding:15px; line-height:1.65; }
    .pill { display:inline-block; padding:3px 8px; border-radius:999px; background:#ecfdf5; color:#047857; font-size:11px; font-weight:800; border:1px solid #bbf7d0; }
    .pill-warn { background:#fff7ed; color:#ea580c; border-color:#fed7aa; }
    .pill-red { background:#fef2f2; color:#dc2626; border-color:#fecaca; }
    .pill-blue { background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe; }
    .confidence-high { color:#047857; font-weight:900; }
    .confidence-medium { color:#d97706; font-weight:900; }
    .confidence-low { color:#dc2626; font-weight:900; }
    .evidence { margin-top:8px; padding:10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; font-size:12px; }
    .muted { color:#64748b; }
    .small { font-size:12px; }
    .objective-main { font-weight:900; color:#0f172a; line-height:1.35; }
    .objective-sub { color:#64748b; font-size:12px; margin-top:4px; }
    code { font-family: Consolas, monospace; font-size:11px; color:#334155; word-break:break-word; }
    .two-col { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    @media (max-width: 900px) { .two-col { grid-template-columns:1fr; } }
  </style>
</head>
<body>
<div class="page">
  <div class="hero">
    <h1>SLO Studio Report</h1>
    <p>
      Bank-grade SLO analysis using configured observability tools. SLO Studio reviewed historical service behavior,
      service-map context, dashboards, alerts, and log evidence to identify missing availability, latency, and error-rate
      SLOs over the selected lookback window.
    </p>
  </div>

  <div class="grid">
    <div class="card kpi"><strong>{{ summary.service_count }}</strong><span>Services</span></div>
    <div class="card kpi"><strong>{{ summary.existing_slo_count }}</strong><span>Existing SLOs</span></div>
    <div class="card kpi"><strong>{{ summary.production_ready_slo_count }}</strong><span>Recommended</span></div>
    <div class="card kpi"><strong>{{ summary.coverage_gap_count }}</strong><span>Coverage Gaps</span></div>
    <div class="card kpi"><strong>{{ summary.evidence_count }}</strong><span>Evidence Items</span></div>
  </div>

  <div class="card">
    <h2>Executive Summary</h2>
    <div class="summary-box">
      SLO Studio analyzed <strong>{{ summary.service_count }}</strong> services over
      <strong>{{ summary.lookback_days }} days</strong> using
      <strong>{{ summary.tools_used | join(", ") }}</strong>. It found
      <strong>{{ summary.existing_slo_count }}</strong> existing SLO signals and identified
      <strong>{{ summary.production_ready_slo_count }}</strong> evidence-backed recommendations for missing or incomplete
      availability, latency, and error-rate SLO coverage. Recommendations follow SRE style: each SLO states a good-event
      ratio, an explicit threshold where applicable, a measurement window, and the resulting error budget.
    </div>
  </div>

  <div class="card">
    <h2>Tools Used for Evidence</h2>
    {% if tool_inventory %}
    <table>
      <thead><tr><th>Tool</th><th>URL</th><th>Purpose</th><th>Auth</th></tr></thead>
      <tbody>
      {% for tool in tool_inventory %}
        <tr>
          <td><strong>{{ tool.name }}</strong></td>
          <td>{{ tool.url }}</td>
          <td>{{ tool.used_for }}</td>
          <td>{{ "Configured" if tool.has_auth else "Not required / not provided" }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
      <p class="muted">No tools were passed to SLO Studio.</p>
    {% endif %}
  </div>

  <div class="card">
    <h2>Missing SLOs and Recommendations</h2>
    {% if production_ready_recommendations %}
    <table>
      <thead>
        <tr>
          <th>Priority</th>
          <th>Service</th>
          <th>Missing SLI</th>
          <th>Recommended SLO</th>
          <th>Confidence</th>
          <th>Evidence</th>
        </tr>
      </thead>
      <tbody>
      {% for rec in production_ready_recommendations[:20] %}
        {% set pct = (rec.confidence * 100) | round(0) %}
        <tr>
          <td><strong>#{{ loop.index }}</strong></td>
          <td><strong>{{ rec.service }}</strong></td>
          <td><span class="pill">{{ rec.sli_type }}</span></td>
          <td>
            <div class="objective-main">{{ rec.description }}</div>
            {% if rec.sli_type == "availability" %}
              <div class="objective-sub">SLI = successful valid requests / all valid requests</div>
            {% elif rec.sli_type == "error_rate" %}
              <div class="objective-sub">SLI = bad valid requests / all valid requests; keep bad events below budget</div>
            {% elif rec.sli_type == "latency" %}
              <div class="objective-sub">SLI = requests faster than threshold / all valid requests</div>
            {% endif %}
            <span class="muted">{{ rec.name }}</span>
          </td>
          <td class="{% if pct >= 80 %}confidence-high{% elif pct >= 65 %}confidence-medium{% else %}confidence-low{% endif %}">{{ pct }}%</td>
          <td>
            {{ rec.rationale }}
            {% for ev in rec.evidence[:5] %}
              <div class="evidence">
                <strong>{{ ev.source }} · {{ ev.signal_type }}</strong><br/>
                {{ ev.value }}<br/>
                <span class="muted">{{ ev.interpretation }}</span>
                {% if ev.query %}<br/><code>{{ ev.query }}</code>{% endif %}
              </div>
            {% endfor %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
      <p class="muted">
        No production-ready recommendations met the evidence threshold. Review the coverage matrix and telemetry gaps below.
      </p>
    {% endif %}
  </div>

  <div class="card">
    <h2>SLO Coverage Matrix</h2>
    <table>
      <thead><tr><th>Service</th><th>SLI</th><th>Status</th><th>Recommended Objective</th><th>Action</th></tr></thead>
      <tbody>
      {% for row in slo_coverage_matrix[:60] %}
        <tr>
          <td><strong>{{ row.service }}</strong></td>
          <td>{{ row.sli_type }}</td>
          <td>
            {% if row.status == "existing" %}
              <span class="pill pill-blue">Existing</span>
            {% elif row.status == "recommended" %}
              <span class="pill">Recommended</span>
            {% elif row.status == "missing_telemetry" %}
              <span class="pill pill-red">Missing telemetry</span>
            {% else %}
              <span class="pill pill-warn">Candidate</span>
            {% endif %}
          </td>
          <td>
            {% if row.recommended_objective_text %}
              <div class="objective-main">{{ row.recommended_objective_text }}</div>
            {% elif row.recommended_objective %}
              {{ row.recommended_objective }}% over {{ row.recommended_window }}
            {% else %}
              <span class="muted">n/a</span>
            {% endif %}
          </td>
          <td>{{ row.action }}<br/><span class="muted small">{{ row.evidence_summary }}</span></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="two-col">
    <div class="card">
      <h2>Existing SLO Coverage</h2>
      {% if existing_slos %}
      <table>
        <thead><tr><th>Service</th><th>SLO / Alert</th><th>SLI Type</th><th>Source</th></tr></thead>
        <tbody>
        {% for slo in existing_slos[:12] %}
          <tr>
            <td>{{ slo.service or "unknown" }}</td>
            <td>{{ slo.slo or slo.name }}</td>
            <td>{{ slo.sli_type or "unknown" }}</td>
            <td>{{ slo.source }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
        <p class="muted">No existing SLOs detected.</p>
      {% endif %}
    </div>

    <div class="card">
      <h2>Candidate SLOs / Validation Needed</h2>
      {% if candidate_recommendations %}
      <table>
        <thead><tr><th>Service</th><th>Candidate</th><th>Confidence</th><th>Validation Needed</th></tr></thead>
        <tbody>
        {% for rec in candidate_recommendations[:12] %}
          <tr>
            <td>{{ rec.service }}</td>
            <td><span class="pill pill-warn">{{ rec.sli_type }}</span><br/>{{ rec.description or rec.name }}<br/><span class="muted small">{{ rec.name }}</span></td>
            <td>{{ (rec.confidence * 100) | round(0) }}%</td>
            <td>{{ rec.assumptions | join("; ") if rec.assumptions else "Validate metric labels, ownership, and operational relevance." }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
        <p class="muted">No candidate SLOs require validation.</p>
      {% endif %}
    </div>
  </div>

  <div class="card">
    <h2>Collection Warnings</h2>
    {% if collection_errors %}
      <table>
        <thead><tr><th>Source</th><th>Operation</th><th>Error</th></tr></thead>
        <tbody>
        {% for item in collection_errors[:10] %}
          <tr><td>{{ item.source }}</td><td>{{ item.operation }}</td><td>{{ item.error }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="muted">No collection errors were recorded.</p>
    {% endif %}
  </div>
</div>
</body>
</html>
