<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>SLO Studio Report</title>
  <style>
    body { font-family: Inter, system-ui, sans-serif; background:#f5f7fb; color:#172033; padding:32px; }
    .page { max-width:1100px; margin:0 auto; }
    .hero { background:linear-gradient(135deg,#0f172a,#047857); color:white; padding:30px; border-radius:20px; margin-bottom:20px; }
    .hero h1 { margin:0 0 8px; font-size:30px; }
    .hero p { margin:0; opacity:.86; line-height:1.6; max-width:820px; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:18px; }
    .card { background:white; border:1px solid #e5e7eb; border-radius:14px; padding:18px; margin-bottom:16px; box-shadow:0 8px 22px rgba(15,23,42,.06); }
    .kpi { text-align:center; }
    .kpi strong { display:block; font-size:28px; color:#059669; }
    .kpi span { color:#64748b; font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.06em; }
    h2 { margin:0 0 12px; font-size:19px; }
    table { width:100%; border-collapse:collapse; font-size:13px; }
    th,td { padding:10px; border-bottom:1px solid #e5e7eb; text-align:left; vertical-align:top; }
    th { color:#64748b; text-transform:uppercase; font-size:11px; letter-spacing:.06em; }
    .pill { display:inline-block; padding:3px 8px; border-radius:999px; background:#ecfdf5; color:#047857; font-size:11px; font-weight:800; border:1px solid #bbf7d0; }
    .pill-orange { background:#fff7ed; color:#ea580c; border-color:#fed7aa; }
    .confidence-high { color:#047857; font-weight:900; }
    .confidence-medium { color:#d97706; font-weight:900; }
    .confidence-low { color:#dc2626; font-weight:900; }
    .summary-box { background:#ecfdf5; border:1px solid #bbf7d0; border-radius:14px; padding:15px; line-height:1.65; }
    .evidence { margin-top:8px; padding:10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; font-size:12px; }
    .muted { color:#64748b; }
    code { font-family: Consolas, monospace; font-size:11px; color:#334155; word-break:break-word; }
    .artifact-box { display:flex; flex-wrap:wrap; gap:10px; }
    .artifact { padding:10px 12px; border-radius:10px; background:#f8fafc; border:1px solid #e2e8f0; font-size:13px; }
  </style>
</head>
<body>
<div class="page">
  <div class="hero">
    <h1>📏 SLO Studio Report</h1>
    <p>
      Concise evidence-backed SLO recommendations based on historical telemetry,
      existing SLO coverage, and confidence scoring.
    </p>
  </div>

  <div class="grid">
    <div class="card kpi"><strong>{{ summary.service_count }}</strong><span>Services</span></div>
    <div class="card kpi"><strong>{{ summary.existing_slo_count }}</strong><span>Existing SLOs</span></div>
    <div class="card kpi"><strong>{{ summary.production_ready_slo_count }}</strong><span>Ready</span></div>
    <div class="card kpi"><strong>{{ summary.candidate_slo_count }}</strong><span>Candidates</span></div>
    <div class="card kpi"><strong>{{ summary.evidence_count }}</strong><span>Evidence</span></div>
  </div>

  <div class="card">
    <h2>Executive Summary</h2>
    <div class="summary-box">
      SLO Studio analyzed <strong>{{ summary.service_count }}</strong> application services over
      <strong>{{ summary.lookback_days }} days</strong>, found <strong>{{ summary.existing_slo_count }}</strong>
      existing SLO-related signals, and identified <strong>{{ summary.production_ready_slo_count }}</strong>
      production-ready SLO recommendations. Recommendations are marked production-ready only when backed by
      measurable telemetry evidence and sufficient confidence.
    </div>
  </div>

  <div class="card">
    <h2>Recommended SLOs</h2>
    {% if production_ready_recommendations %}
    <table>
      <thead>
        <tr>
          <th>Priority</th>
          <th>Service</th>
          <th>SLO</th>
          <th>Objective</th>
          <th>Confidence</th>
          <th>Evidence</th>
        </tr>
      </thead>
      <tbody>
      {% for rec in production_ready_recommendations[:5] %}
        {% set pct = (rec.confidence * 100) | round(0) %}
        <tr>
          <td><strong>#{{ loop.index }}</strong></td>
          <td><strong>{{ rec.service }}</strong></td>
          <td><span class="pill">{{ rec.sli_type }}</span><br/>{{ rec.name }}</td>
          <td>{{ rec.objective }}% / {{ rec.window }}</td>
          <td class="{% if pct >= 80 %}confidence-high{% elif pct >= 65 %}confidence-medium{% else %}confidence-low{% endif %}">
            {{ pct }}%
          </td>
          <td>
            {{ rec.rationale }}
            {% for ev in rec.evidence[:2] %}
              <div class="evidence">
                <strong>{{ ev.source }} · {{ ev.signal_type }}</strong><br/>
                {{ ev.value }}<br/>
                <span class="muted">{{ ev.interpretation }}</span>
                {% if ev.query %}<br/><code>{{ ev.query }}</code>{% endif %}
              </div>
            {% endfor %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
      <p class="muted">
        No production-ready SLOs met the confidence threshold. SLO Studio found candidates, but they need stronger
        availability, latency, trace, or ownership evidence before YAML should be promoted.
      </p>
    {% endif %}
  </div>

  <div class="card">
    <h2>Existing SLO Coverage</h2>
    {% if existing_slos %}
      <table>
        <thead><tr><th>Service</th><th>SLO / Alert</th><th>Severity</th><th>Source</th></tr></thead>
        <tbody>
        {% for slo in existing_slos[:8] %}
          <tr>
            <td>{{ slo.service or "unknown" }}</td>
            <td>{{ slo.slo or slo.name }}</td>
            <td>{{ slo.severity or "n/a" }}</td>
            <td>{{ slo.source }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% if existing_slos | length > 8 %}
        <p class="muted">Showing first 8 of {{ existing_slos | length }} existing SLO-related signals.</p>
      {% endif %}
    {% else %}
      <p class="muted">No existing SLOs detected from Prometheus rules or alerts.</p>
    {% endif %}
  </div>

  <div class="card">
    <h2>Candidate SLOs Needing Validation</h2>
    {% if candidate_recommendations %}
    <table>
      <thead><tr><th>Service</th><th>Candidate</th><th>Confidence</th><th>Reason</th></tr></thead>
      <tbody>
      {% for rec in candidate_recommendations[:8] %}
        <tr>
          <td>{{ rec.service }}</td>
          <td><span class="pill pill-orange">{{ rec.sli_type }}</span><br/>{{ rec.name }}</td>
          <td>{{ (rec.confidence * 100) | round(0) }}%</td>
          <td>{{ rec.assumptions | join("; ") if rec.assumptions else "Requires stronger telemetry evidence before production rollout." }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
      <p class="muted">No candidate SLOs require additional validation.</p>
    {% endif %}
  </div>

  <div class="card">
    <h2>Generated Artifacts</h2>
    <div class="artifact-box">
      <div class="artifact"><strong>HTML Report</strong><br/><span class="muted">Executive-ready SLO summary</span></div>
      <div class="artifact"><strong>JSON Evidence</strong><br/><span class="muted">Machine-readable recommendations</span></div>
      <div class="artifact"><strong>Sloth YAML</strong><br/><span class="muted">Generated only for production-ready SLOs</span></div>
    </div>
  </div>
</div>
</body>
</html>