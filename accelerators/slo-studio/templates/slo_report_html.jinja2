<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>SLO Studio Report</title>
  <style>
    body {
      font-family: Inter, system-ui, sans-serif;
      background: #f6f7fb;
      color: #172033;
      padding: 32px;
    }
    .page { max-width: 1100px; margin: 0 auto; }
    .hero {
      background: linear-gradient(135deg, #182033, #4338ca);
      color: white;
      padding: 28px;
      border-radius: 18px;
      margin-bottom: 24px;
    }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
    .card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 18px;
      box-shadow: 0 6px 20px rgba(15, 23, 42, 0.06);
    }
    .kpi { text-align: center; }
    .kpi strong { display: block; font-size: 32px; color: #4f46e5; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; border-bottom: 1px solid #e5e7eb; padding: 10px; vertical-align: top; }
    th { color: #64748b; font-size: 12px; text-transform: uppercase; }
    .sev-critical, .sev-high { color: #dc2626; font-weight: 700; }
    .sev-medium { color: #d97706; font-weight: 700; }
    .sev-low { color: #059669; font-weight: 700; }
    pre {
      white-space: pre-wrap;
      background: #0f172a;
      color: #e2e8f0;
      padding: 16px;
      border-radius: 12px;
      overflow-x: auto;
    }
  </style>
</head>
<body>
<div class="page">
  <div class="hero">
    <h1>SLO Studio Report</h1>
    <p>Service Level Objective discovery, coverage analysis, and generated Sloth configuration.</p>
  </div>

  <div class="grid">
    <div class="card kpi"><strong>{{ summary.service_count }}</strong><span>Services Discovered</span></div>
    <div class="card kpi"><strong>{{ summary.existing_slo_count }}</strong><span>Existing SLOs</span></div>
    <div class="card kpi"><strong>{{ summary.recommended_slo_count }}</strong><span>Recommended SLOs</span></div>
    <div class="card kpi"><strong>{{ summary.finding_count }}</strong><span>Findings</span></div>
  </div>

  <div class="card">
    <h2>Existing SLOs Detected</h2>
    <table>
      <thead>
        <tr><th>Name</th><th>Service</th><th>SLO</th><th>Severity</th><th>Source</th></tr>
      </thead>
      <tbody>
      {% for slo in existing_slos %}
        <tr>
          <td>{{ slo.name }}</td>
          <td>{{ slo.service }}</td>
          <td>{{ slo.slo }}</td>
          <td>{{ slo.severity }}</td>
          <td>{{ slo.source }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Findings</h2>
    <table>
      <thead>
        <tr><th>Service</th><th>Severity</th><th>Finding</th><th>Recommendation</th></tr>
      </thead>
      <tbody>
      {% for finding in findings %}
        <tr>
          <td>{{ finding.service }}</td>
          <td class="sev-{{ finding.severity }}">{{ finding.severity }}</td>
          <td><strong>{{ finding.title }}</strong><br>{{ finding.description }}</td>
          <td>{{ finding.recommendation }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Recommended SLOs</h2>
    <table>
      <thead>
        <tr><th>Service</th><th>Type</th><th>Objective</th><th>Description</th></tr>
      </thead>
      <tbody>
      {% for slo in recommendations %}
        <tr>
          <td>{{ slo.service }}</td>
          <td>{{ slo.sli_type }}</td>
          <td>{{ slo.objective }}%</td>
          <td>{{ slo.description }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Generated Sloth YAML</h2>
    <pre>{{ sloth_yaml }}</pre>
  </div>
</div>
</body>
</html>