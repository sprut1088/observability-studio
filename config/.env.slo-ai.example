# SLO Studio AI Advisor settings
# Do not commit real API keys.

SLO_AI_ENABLED=true

# Use one of: anthropic, openai
SLO_AI_PROVIDER=anthropic

# Anthropic example
SLO_AI_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_KEY=PASTE_ANTHROPIC_KEY_HERE

